APP_NAME="Transcribed Subtitle Extension"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=transcribed_subtitle_extension
DB_USERNAME=subtitle
DB_PASSWORD=subtitle
DB_SCHEMA=public
DB_SSLMODE=prefer

CACHE_STORE=database
QUEUE_CONNECTION=redis
SUBTITLE_QUEUE_CONNECTION=redis
SUBTITLE_QUEUE=subtitle-ai
SUBTITLE_STALE_PREPARING_SECONDS=60
SUBTITLE_TRACE_SLOW_QUEUE_WAIT_MS=30000
SUBTITLE_TRACE_SLOW_STAGE_MS=120000
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=1260
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=56379
REDIS_QUEUE_DB=2
REDIS_QUEUE=subtitle-ai
REDIS_QUEUE_RETRY_AFTER=1260
REDIS_QUEUE_BLOCK_FOR=5

OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_ENRICHMENT_MODEL=gpt-4o-mini
OPENAI_TOKENIZATION_MODEL=gpt-4o-mini
OPENAI_ROMANIZATION_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_ENRICHMENT_TIMEOUT_SECONDS=120
SUBTITLE_ENRICHMENT_CUE_BATCH_SIZE=10

ELEVENLABS_API_KEY=
ELEVENLABS_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2
ELEVENLABS_TRANSCRIPTION_TIMEOUT_SECONDS=600

YOUTUBE_AUDIO_BINARY=yt-dlp
YOUTUBE_METADATA_TIMEOUT_SECONDS=60
YOUTUBE_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=600
SUBTITLE_MAX_VIDEO_DURATION_SECONDS=3600
SUBTITLE_PROCESSING_TIMEOUT_SECONDS=0
SUBTITLE_RATE_LIMIT_PER_INSTALL_PER_MINUTE=30
SUBTITLE_RATE_LIMIT_PER_IP_PER_MINUTE=120
SUBTITLE_STATUS_RATE_LIMIT_PER_INSTALL_PER_MINUTE=120
SUBTITLE_STATUS_RATE_LIMIT_PER_IP_PER_MINUTE=300
