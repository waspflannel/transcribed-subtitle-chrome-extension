APP_NAME="Transcribe"
MARKETING_PRODUCT_NAME="Transcribe"
SUPPORT_EMAIL=support@example.test
CHROME_EXTENSION_URL=
CHROME_EXTENSION_RELEASE_VERSION=0.1.0
CHROME_EXTENSION_API_HOST_PERMISSION=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
# Add only trusted LAN/VPN client networks for a private self-hosted instance.
INSTANCE_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
# Optional comma-separated Chrome extension IDs. Empty allows any extension origin.
INSTANCE_ALLOWED_EXTENSION_IDS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=transcribed_subtitle_extension
DB_USERNAME=subtitle
DB_PASSWORD=subtitle
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=5

CACHE_STORE=database
QUEUE_CONNECTION=redis
SUBTITLE_QUEUE_CONNECTION=redis
SUBTITLE_GENERATION_QUEUE=subtitle-generation
SUBTITLE_BATCH_QUEUE=subtitle-batch
SUBTITLE_GENERATION_WORKERS=9
SUBTITLE_BATCH_WORKERS=22
SUBTITLE_CONCURRENCY_CACHE_STORE=subtitle_concurrency
SUBTITLE_CONCURRENCY_REDIS_CONNECTION=cache
SUBTITLE_CONCURRENCY_REDIS_LOCK_CONNECTION=cache
SUBTITLE_STALE_PREPARING_SECONDS=60
SUBTITLE_TRACE_SLOW_QUEUE_WAIT_MS=30000
SUBTITLE_TRACE_SLOW_STAGE_MS=120000
SUBTITLE_WORKER_TIMEOUT_SECONDS=1200
SUBTITLE_BATCH_WORKER_TIMEOUT_SECONDS=330
SUBTITLE_PROCESSING_TIMEOUT_SECONDS=0
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=1260
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=56379
REDIS_QUEUE_DB=2
REDIS_QUEUE=subtitle-generation
REDIS_QUEUE_RETRY_AFTER=1260
REDIS_BATCH_QUEUE_RETRY_AFTER=360
REDIS_QUEUE_BLOCK_FOR=1
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_READ_TIMEOUT_SECONDS=5

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Text agents use this provider; speech-to-text continues to use ElevenLabs.
AI_PROVIDER=openai
CEREBRAS_API_KEY=
CEREBRAS_URL=https://api.cerebras.ai/v1
OPENAI_REASONING_EFFORT=xhigh
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_FAST_MODE_ENABLED=true
OPENAI_ENRICHMENT_TIMEOUT_SECONDS=120
# Optional Codex ChatGPT sign-in: install the current stable CLI for HTTP and queue workers.
# Use an absolute executable path if Codex is not on their PATH (codex.exe on Windows).
CODEX_BINARY=codex
SUBTITLE_ENRICHMENT_CUE_BATCH_CHAR_BUDGET=1000
SUBTITLE_ENRICHMENT_CUE_BATCH_MAX_CUES=20
# Analysis batches preserve cue order and prioritize opening playback.
SUBTITLE_ANALYSIS_FIRST_BATCH_SECONDS=10
SUBTITLE_ANALYSIS_FIRST_BATCH_MAX_CUES=2
SUBTITLE_ANALYSIS_BATCH_SECONDS=30
SUBTITLE_BALANCED_BATCHES=true
SUBTITLE_AUDIO_DIRECT_CHUNKS=true
OPENAI_TOKENIZATION_MICROUSD_PER_CUE=0
OPENAI_ALIGNMENT_MICROUSD_PER_CALL=0
OPENAI_TRANSLATION_MICROUSD_PER_CUE=0
OPENAI_ROMANIZATION_MICROUSD_PER_CUE=0
OPENAI_ENRICHMENT_MICROUSD_PER_CUE=0

ELEVENLABS_API_KEY=
ELEVENLABS_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TRANSCRIPTION_TIMEOUT_SECONDS=600
SUBTITLE_TRANSCRIPTION_INGESTION_MODE=upload
# Per-video transcript cache for this installation; <=0 disables it.
SUBTITLE_TRANSCRIPT_CACHE_TTL_DAYS=30
SUBTITLE_TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=2
ELEVENLABS_SCRIBE_MICROUSD_PER_MINUTE=0


FFMPEG_BINARY=ffmpeg
SUBTITLE_AUDIO_PREP_FFMPEG_TIMEOUT_SECONDS=600
YOUTUBE_AUDIO_BINARY=yt-dlp
YOUTUBE_METADATA_TIMEOUT_SECONDS=60
YOUTUBE_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=600
SUBTITLE_RATE_LIMIT_PER_INSTALL_PER_MINUTE=30
SUBTITLE_RATE_LIMIT_PER_IP_PER_MINUTE=120
SUBTITLE_STATUS_RATE_LIMIT_PER_INSTALL_PER_MINUTE=120
SUBTITLE_STATUS_RATE_LIMIT_PER_IP_PER_MINUTE=300

# Optional estimated Cerebras costs; zero means no configured estimate.
CEREBRAS_ALIGNMENT_MICROUSD_PER_CALL=0
CEREBRAS_TOKENIZATION_MICROUSD_PER_CUE=0
CEREBRAS_TRANSLATION_MICROUSD_PER_CUE=0
CEREBRAS_ROMANIZATION_MICROUSD_PER_CUE=0
CEREBRAS_ENRICHMENT_MICROUSD_PER_CUE=0

# Short opening chunk; later chunks grow as needed to stay within the upload cap.
SUBTITLE_TRANSCRIPTION_CHUNK_FIRST_SECONDS=15
SUBTITLE_TRANSCRIPTION_CHUNK_SECOND_SECONDS=20
SUBTITLE_YOUTUBE_DIRECT_DOWNLOAD=false
SUBTITLE_YOUTUBE_METADATA_PREFETCH=false
SUBTITLE_TRANSCRIPTION_CHUNK_MIN_AUDIO_SECONDS=45
SUBTITLE_TRANSCRIPTION_CHUNK_TARGET_SECONDS=60
SUBTITLE_TRANSCRIPTION_CHUNK_MAX_CHUNKS=8

# Technical provider limits shared by HTTP and queue workers; tune for your API quotas.
SUBTITLE_AI_GLOBAL_RATE_LIMIT_PER_MINUTE=300
SUBTITLE_PROVIDER_GLOBAL_CONCURRENCY=30
# Codex sessions share one ChatGPT login; keep this small.
SUBTITLE_CODEX_CONCURRENCY=3
