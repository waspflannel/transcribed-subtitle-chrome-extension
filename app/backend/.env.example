OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_ENRICHMENT_MODEL=gpt-4o-mini
OPENAI_TOKENIZATION_MODEL=gpt-4o-mini
OPENAI_ROMANIZATION_MODEL=gpt-4o-mini
# Merged tokenize+translate call; defaults to OPENAI_TOKENIZATION_MODEL when unset.
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_ENRICHMENT_TIMEOUT_SECONDS=120
SUBTITLE_ENRICHMENT_CUE_BATCH_SIZE=10
SUBTITLE_ENRICHMENT_CUE_BATCH_CHAR_BUDGET=1000
SUBTITLE_ENRICHMENT_CUE_BATCH_MAX_CUES=20
SUBTITLE_DETERMINISTIC_ROMANIZATION_ENABLED=true
