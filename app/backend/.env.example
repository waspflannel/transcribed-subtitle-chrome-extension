SUBTITLE_BASE_MEDIUM_BUDGET_SECONDS=600
SUBTITLE_BASE_NEAR_LIMIT_BUDGET_SECONDS=1800
SUBTITLE_PLUS_SHORT_BUDGET_SECONDS=180
SUBTITLE_PLUS_MEDIUM_BUDGET_SECONDS=420
SUBTITLE_PLUS_NEAR_LIMIT_BUDGET_SECONDS=1320
SUBTITLE_PRO_SHORT_BUDGET_SECONDS=120
SUBTITLE_PRO_MEDIUM_BUDGET_SECONDS=300
SUBTITLE_PRO_NEAR_LIMIT_BUDGET_SECONDS=900
