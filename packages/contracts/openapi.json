{
  "openapi": "3.1.0",
  "info": {
    "title": "Transcribe API",
    "version": "0.1.0",
    "description": "API contract for requesting subtitle generation and receiving subtitle-focused generated tracks."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001",
      "description": "Local Laravel development server"
    }
  ],
  "paths": {
    "/v1/subtitle-audio/prefetch": {
      "post": {
        "operationId": "prefetchSubtitleAudio",
        "summary": "Prepare short-lived instance-local YouTube metadata without creating a generation. Disabled by default; best effort.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "youtubeVideoId"
                ],
                "properties": {
                  "youtubeVideoId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{11}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Best-effort prefetch queued when enabled. Does not guarantee a cache hit or start provider work.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "422": {
            "description": "Invalid YouTube video ID."
          }
        }
      }
    },
    "/v1/subtitle-jobs": {
      "get": {
        "operationId": "listSubtitleJobs",
        "summary": "List recent subtitle jobs on this instance.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "youtubeVideoId",
            "in": "query",
            "required": false,
            "description": "Return all completed, unexpired, readable generations for this video. Unfiltered history remains limited to 25 entries.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent subtitle job history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/subtitle-job-history-response.schema.json"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "operationId": "createSubtitleJob",
        "summary": "Create a generated subtitle job for a public YouTube video or Short.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/create-subtitle-job-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compatible subtitle track was already completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "202": {
            "description": "Subtitle generation is queued, running, or has not yet produced a completed track.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-jobs/{jobId}": {
      "get": {
        "operationId": "getSubtitleJob",
        "summary": "Poll one subtitle job until it completes, fails, or is cancelled.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current subtitle job status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "operationId": "cancelSubtitleJob",
        "summary": "Cancel one queued or running subtitle generation.",
        "description": "Cancels the generation run, returns the cancellation snapshot. A queued run never reaches a provider. A running provider request may finish externally, but its late result is ignored by the immutable run and terminal status guards. Repeating cancellation for an already-cancelled run is idempotent.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current cancelled subtitle job status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-generations/{jobId}": {
      "delete": {
        "operationId": "deleteSubtitleGeneration",
        "summary": "Delete one completed subtitle generation.",
        "description": "Removes the saved job, track, and associated correction data, including the only generation for a video. Missing and noncompleted jobs return 404. Queued or running jobs must use the cancellation endpoint.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The saved generation was deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-jobs/{jobId}/lyrics": {
      "post": {
        "operationId": "startLyricsCorrection",
        "summary": "Queue a correction from pasted plain-text lyrics.",
        "description": "Requires expectedTrackId to match the current track. Replaces the full track using the pasted lyrics and existing timing slots. Partial merging is unavailable; the removed allowPartial field is rejected.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/lyrics-correction-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
              "description": "Lyrics correction accepted for asynchronous processing. Optional AI selection overrides apply only to this correction; the response reports its pinned provider, model, and fast mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/lyrics-correction-status.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "get": {
        "operationId": "getLyricsCorrectionStatus",
        "summary": "Get the current pasted-lyrics correction status.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current pasted-lyrics correction status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/lyrics-correction-status.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "operationId": "cancelLyricsCorrection",
        "summary": "Cancel a queued or running pasted-lyrics correction.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/lyrics-correction-cancel-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current correction status after cancellation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/lyrics-correction-status.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-jobs/{jobId}/cues/{cueId}/tokens/{tokenIndex}": {
      "patch": {
        "description": "Edit one token and refresh its cue translation, enabled romanization, and word cards before atomic publication. Provider failure leaves the track unchanged.",
        "operationId": "quickFixSubtitleToken",
        "summary": "Correct one source token and refresh its learning data.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "tokenIndex",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/quick-fix-token-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated canonical subtitle track.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/track-response.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "description": "AI enrichment failed; the existing track is unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api-error.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "AI provider unavailable; the existing track is unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/api-error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/v1/learning-tokens": {
      "post": {
        "operationId": "enrichLearningToken",
        "summary": "Enrich one clicked subtitle token for a generated track.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/learning-token-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learning token metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/learning-token-response.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/up": {
      "get": {
        "operationId": "health",
        "summary": "Backend health check.",
        "responses": {
          "200": {
            "description": "Backend process is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/settings": {
      "get": {
        "summary": "Read instance provider settings without secrets",
        "responses": {
          "200": {
            "description": "Instance settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/instance-settings.schema.json"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ]
      },
      "put": {
        "summary": "Update encrypted instance provider keys, models and retention",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/update-instance-settings.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated instance settings without secrets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/instance-settings.schema.json"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ]
      }
    },
    "/v1/codex": {
      "get": {
        "operationId": "getCodexAccount",
        "summary": "Read Codex connection, login progress and available models.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "responses": {
          "200": {
            "description": "Public Codex connection state. OAuth credentials remain on the backend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/codex-account.schema.json"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "operationId": "disconnectCodexAccount",
        "summary": "Disconnect Codex from this private instance.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "responses": {
          "200": {
            "description": "Public Codex connection state. OAuth credentials remain on the backend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/codex-account.schema.json"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/codex/login": {
      "post": {
        "operationId": "loginCodexAccount",
        "summary": "Start Codex browser OAuth sign-in on this private instance.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "responses": {
          "202": {
            "description": "Public Codex connection state. OAuth credentials remain on the backend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/codex-account.schema.json"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ExtensionInstallId": {
        "name": "X-Extension-Install-Id",
        "in": "header",
        "required": true,
        "description": "Browser installation identifier for local request tracing. It is not an authentication credential or an ownership boundary.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Request failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "Forbidden": {
        "description": "This request is not allowed on this private instance.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "Conflict": {
        "description": "The requested operation conflicts with the current resource state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      }
    }
  }
}
