{
  "openapi": "3.1.0",
  "info": {
    "title": "YouTube AI Language Subtitles API",
    "version": "0.1.0",
    "description": "API contract for requesting subtitle generation and receiving subtitle-focused generated tracks."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Laravel development server"
    }
  ],
  "paths": {
    "/v1/extension-auth/login": {
      "post": {
        "operationId": "loginExtension",
        "summary": "Issue a scoped extension API token for a verified account.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/extension-login-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extension token and safe account summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/extension-auth-response.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/extension-auth/account": {
      "get": {
        "operationId": "getExtensionAccount",
        "summary": "Return the current extension account summary.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Safe account summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/extension-account-response.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/extension-auth/logout": {
      "post": {
        "operationId": "logoutExtension",
        "summary": "Revoke the active extension API token.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "responses": {
          "200": {
            "description": "The token was revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-jobs": {
      "get": {
        "operationId": "listSubtitleJobs",
        "summary": "List recent subtitle jobs for the authenticated account.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Recent subtitle job history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/subtitle-job-history-response.schema.json"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "operationId": "createSubtitleJob",
        "summary": "Create a generated subtitle job for a public YouTube video.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/create-subtitle-job-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compatible subtitle track was already completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "202": {
            "description": "Subtitle generation is queued, running, or has not yet produced a completed track.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-jobs/{jobId}": {
      "get": {
        "operationId": "getSubtitleJob",
        "summary": "Poll one subtitle job until it completes or fails.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current subtitle job status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/learning-tokens": {
      "post": {
        "operationId": "enrichLearningToken",
        "summary": "Enrich one clicked subtitle token for a generated track.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/learning-token-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learning token metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/learning-token-response.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/up": {
      "get": {
        "operationId": "health",
        "summary": "Backend health check.",
        "responses": {
          "200": {
            "description": "Backend process is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ExtensionInstallId": {
        "name": "X-Extension-Install-Id",
        "in": "header",
        "required": true,
        "description": "Anonymous extension installation identifier used for abuse controls. This is not a user account identifier.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "ExtensionAuthorization": {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "description": "Bearer extension API token issued by /v1/extension-auth/login.",
        "schema": {
          "type": "string",
          "pattern": "^Bearer .+$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Request failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "Missing, invalid, revoked, or expired extension token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated token or account cannot perform the requested action.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      }
    }
  }
}
