{
  "openapi": "3.1.0",
  "info": {
    "title": "Transcribe API",
    "version": "0.1.0",
    "description": "API contract for requesting subtitle generation and receiving subtitle-focused generated tracks."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Laravel development server"
    }
  ],
  "paths": {
    "/v1/subtitle-audio/prefetch": {
      "post": {
        "operationId": "prefetchSubtitleAudio",
        "summary": "Prepare short-lived account-scoped YouTube metadata without creating a generation. Disabled by default; best effort.",
        "parameters": [
          { "$ref": "#/components/parameters/ExtensionInstallId" },
          { "$ref": "#/components/parameters/ExtensionAuthorization" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["youtubeVideoId"],
            "properties": { "youtubeVideoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" } }
          } } }
        },
        "responses": {
          "200": { "description": "Best-effort prefetch queued when enabled. Does not guarantee a cache hit or start paid work.", "content": { "application/json": { "schema": {
            "type": "object", "additionalProperties": false, "required": ["ok"], "properties": { "ok": { "type": "boolean", "const": true } }
          } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "422": { "description": "Invalid YouTube video ID." }
        }
      }
    },
    "/v1/extension-auth/login": {
      "post": {
        "operationId": "loginExtension",
        "summary": "Issue a scoped extension API token for a verified account.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/extension-login-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extension token and safe account summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/extension-auth-response.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/extension-auth/account": {
      "get": {
        "operationId": "getExtensionAccount",
        "summary": "Return the current extension account summary.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "responses": {
          "200": {
            "description": "Safe account summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/extension-account-response.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/extension-auth/logout": {
      "post": {
        "operationId": "logoutExtension",
        "summary": "Revoke the active extension API token.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "responses": {
          "200": {
            "description": "The token was revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-jobs": {
      "get": {
        "operationId": "listSubtitleJobs",
        "summary": "List recent subtitle jobs for the authenticated account.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          },
          {
            "name": "youtubeVideoId",
            "in": "query",
            "required": false,
            "description": "Return all completed, unexpired, readable generations for this video. Unfiltered history remains limited to 25 entries.",
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent subtitle job history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/subtitle-job-history-response.schema.json"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "operationId": "createSubtitleJob",
        "summary": "Create a generated subtitle job for a public YouTube video or Short.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/create-subtitle-job-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compatible subtitle track was already completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "202": {
            "description": "Subtitle generation is queued, running, or has not yet produced a completed track.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-jobs/{jobId}": {
      "get": {
        "operationId": "getSubtitleJob",
        "summary": "Poll one subtitle job until it completes, fails, or is cancelled.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current subtitle job status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "operationId": "cancelSubtitleJob",
        "summary": "Cancel one queued or running subtitle generation.",
        "description": "Cancels the owned generation run, releases its reserved minutes once, and returns the cancellation snapshot. A queued run never reaches a provider. A running provider request may finish externally, but its late result is ignored by the immutable run and terminal status guards. Repeating cancellation for an already-cancelled run is idempotent.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current cancelled subtitle job status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/job-response.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/subtitle-generations/{jobId}": {
      "delete": {
        "operationId": "deleteSubtitleGeneration",
        "summary": "Delete one completed subtitle generation owned by the authenticated account.",
        "description": "Removes the saved job, track, and associated correction data, including the account's only generation for a video. Completed usage is not refunded. Missing, unowned, and noncompleted jobs return 404. Queued or running jobs must use the cancellation endpoint.",
        "parameters": [
          { "$ref": "#/components/parameters/ExtensionInstallId" },
          { "$ref": "#/components/parameters/ExtensionAuthorization" },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The saved generation was deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ok"],
                  "properties": { "ok": { "type": "boolean", "const": true } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/subtitle-jobs/{jobId}/lyrics": {
      "post": {
        "operationId": "startLyricsCorrection",
        "summary": "Queue a correction from pasted plain-text lyrics.",
        "description": "Requires expectedTrackId to match the current track. Rejects stale track identity and lyrics that cannot fit the existing timing slots before queueing. Set allowPartial to true to continue after suspected incomplete lyrics and have the AI merge the supplied lyrics with the generated transcript.",
        "parameters": [
          {"$ref": "#/components/parameters/ExtensionInstallId"},
          {"$ref": "#/components/parameters/ExtensionAuthorization"},
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "./schemas/lyrics-correction-request.schema.json"}
            }
          }
        },
        "responses": {
          "202": {
            "description": "Lyrics correction accepted for asynchronous processing.",
            "content": {
              "application/json": {
                "schema": {"$ref": "./schemas/lyrics-correction-status.schema.json"}
              }
            }
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "402": {"$ref": "#/components/responses/PaymentRequired"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      },
      "get": {
        "operationId": "getLyricsCorrectionStatus",
        "summary": "Get the current pasted-lyrics correction status.",
        "parameters": [
          {"$ref": "#/components/parameters/ExtensionInstallId"},
          {"$ref": "#/components/parameters/ExtensionAuthorization"},
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Current pasted-lyrics correction status.",
            "content": {
              "application/json": {
                "schema": {"$ref": "./schemas/lyrics-correction-status.schema.json"}
              }
            }
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      },
      "delete": {
        "operationId": "cancelLyricsCorrection",
        "summary": "Cancel a queued or running pasted-lyrics correction.",
        "parameters": [
          {"$ref": "#/components/parameters/ExtensionInstallId"},
          {"$ref": "#/components/parameters/ExtensionAuthorization"},
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "./schemas/lyrics-correction-cancel-request.schema.json"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current correction status after cancellation.",
            "content": {
              "application/json": {
                "schema": {"$ref": "./schemas/lyrics-correction-status.schema.json"}
              }
            }
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/v1/subtitle-jobs/{jobId}/cues/{cueId}/tokens/{tokenIndex}": {
      "patch": {
        "description": "Edit one token and refresh its cue translation, enabled romanization, and word cards before atomic publication. Provider failure leaves the track unchanged.",
        "operationId": "quickFixSubtitleToken",
        "summary": "Correct one source token and refresh its learning data.",
        "parameters": [
          {"$ref": "#/components/parameters/ExtensionInstallId"},
          {"$ref": "#/components/parameters/ExtensionAuthorization"},
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "cueId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "minLength": 1}
          },
          {
            "name": "tokenIndex",
            "in": "path",
            "required": true,
            "schema": {"type": "integer", "minimum": 0, "maximum": 9999}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "./schemas/quick-fix-token-request.schema.json"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated canonical subtitle track.",
            "content": {
              "application/json": {
                "schema": {"$ref": "./schemas/track-response.schema.json"}
              }
            }
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "402": {"$ref": "#/components/responses/PaymentRequired"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "502": {
            "description": "AI enrichment failed; the existing track is unchanged.",
            "content": {"application/json": {"schema": {"$ref": "./schemas/api-error.schema.json"}}}
          },
          "503": {
            "description": "AI provider unavailable; the existing track is unchanged.",
            "content": {"application/json": {"schema": {"$ref": "./schemas/api-error.schema.json"}}}
          }
        }
      }
    },
    "/v1/learning-tokens": {
      "post": {
        "operationId": "enrichLearningToken",
        "summary": "Enrich one clicked subtitle token for a generated track.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtensionInstallId"
          },
          {
            "$ref": "#/components/parameters/ExtensionAuthorization"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/learning-token-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learning token metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/learning-token-response.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/up": {
      "get": {
        "operationId": "health",
        "summary": "Backend health check.",
        "responses": {
          "200": {
            "description": "Backend process is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ExtensionInstallId": {
        "name": "X-Extension-Install-Id",
        "in": "header",
        "required": true,
        "description": "Anonymous extension installation identifier used for abuse controls. This is not a user account identifier.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "ExtensionAuthorization": {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "description": "Bearer extension API token issued by /v1/extension-auth/login.",
        "schema": {
          "type": "string",
          "pattern": "^Bearer .+$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Request failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "Missing, invalid, revoked, or expired extension token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated token or account cannot perform the requested action.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "PaymentRequired": {
        "description": "An active billing plan is required.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      },
      "Conflict": {
        "description": "The requested operation conflicts with the current resource state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/api-error.schema.json"
            }
          }
        }
      }
    }
  }
}
