{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/track-lookup-response.schema.json",
  "title": "TrackLookupResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "found"
  ],
  "properties": {
    "found": {
      "type": "boolean"
    },
    "trackId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "const": "ready"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
