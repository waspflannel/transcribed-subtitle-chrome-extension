{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/track-response.schema.json",
  "title": "TrackResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trackId",
    "jobId",
    "youtubeVideoId",
    "sourceLanguage",
    "targetLanguage",
    "generatedAt",
    "expiresAt",
    "webVtt",
    "cues"
  ],
  "properties": {
    "trackId": {
      "type": "string",
      "format": "uuid"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "youtubeVideoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "sourceLanguage": {
      "type": "string",
      "enum": [
        "auto",
        "ar",
        "en",
        "es",
        "pt",
        "fr",
        "de",
        "it"
      ]
    },
    "targetLanguage": {
      "type": "string",
      "const": "en"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "webVtt": {
      "type": "string",
      "minLength": 1
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "cue.schema.json"
      }
    }
  }
}
