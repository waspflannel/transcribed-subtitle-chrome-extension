{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/quick-fix-token-request.schema.json",
  "title": "QuickFixTokenRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedTrackId", "text"],
  "properties": {
    "expectedTrackId": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 84,
      "pattern": "[^\\s]"
    }
  }
}
