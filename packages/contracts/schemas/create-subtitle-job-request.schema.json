{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/create-subtitle-job-request.schema.json",
  "title": "CreateSubtitleJobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "youtubeVideoId",
    "youtubeUrl",
    "sourceLanguage",
    "targetLanguage",
    "enrichmentMode",
    "includeRomanization",
    "includeTranslation"
  ],
  "properties": {
    "vocabularyHints": {
      "type": "array",
      "maxItems": 20,
      "description": "Optional names or terms for this generation only. Each term has at most five words and 49 characters.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 49,
        "pattern": "^[^<>{}\\[\\]\\\\\\s]+(?:\\s+[^<>{}\\[\\]\\\\\\s]+){0,4}$"
      }
    },
    "youtubeVideoId": {
      "type": "string",
      "description": "Canonical 11-character YouTube video ID.",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "youtubeUrl": {
      "type": "string",
      "format": "uri",
      "description": "YouTube watch or Shorts URL captured by the extension for diagnostics and validation."
    },
    "videoDurationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "description": "Known YouTube video duration. Backend must still enforce the 60 minute limit."
    },
    "sourceLanguage": {
      "type": "string",
      "enum": [
        "auto",
        "bel",
        "bos",
        "bul",
        "cat",
        "hrv",
        "ces",
        "dan",
        "nld",
