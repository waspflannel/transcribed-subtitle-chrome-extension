        "tel",
        "afr",
        "ara",
        "asm",
        "ast",
        "mya",
        "hau",
        "heb",
        "jav",
        "kor",
        "kir",
        "ltz",
        "mri",
        "oci",
        "pan",
        "tgk",
        "tha",
