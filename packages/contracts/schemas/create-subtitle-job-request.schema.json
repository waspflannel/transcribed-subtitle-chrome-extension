        "snd",
        "som",
        "urd",
        "wol",
        "xho",
        "yor",
        "zul"
      ]
    },
    "includeRomanization": {
      "type": "boolean",
      "description": "When true, backend may add cue and token romanization for non-Latin source text. When false, generation skips romanization."
    },
    "includeTranslation": {
      "type": "boolean",
      "description": "When true, backend translates cue text into the selected target language. When false, translatedText remains the source text."
    },
    "forceRegenerate": {
      "type": "boolean",
      "default": false,
      "description": "When true, rebuild a compatible completed track from the original transcription with fresh tokens, romanization, and translation. Original transcription may be cached; active jobs are still reused. Regeneration uses normal plan minutes."
    },
    "aiProvider": {
      "type": "string",
      "enum": [
        "openai",
        "cerebras",
        "codex",
        "claude"
      ],
      "description": "The selected analysis provider stays pinned for this generation."
    },
    "aiModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Model from the connected Codex account. Required for Codex; omitted for other providers."
    },
    "aiFastMode": {
      "type": "boolean",
      "default": false,
      "description": "Use Codex fast service tier. Omitted for API providers."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "aiProvider"
        ],
        "properties": {
          "aiProvider": {
            "const": "codex"
          }
        }
      },
      "then": {
        "required": [
          "aiModel"
        ]
      },
      "else": {
        "not": {
          "required": [
            "aiModel"
          ]
        },
        "properties": {
          "aiFastMode": {
            "const": false
          }
        }
      }
    }
  ]
}
