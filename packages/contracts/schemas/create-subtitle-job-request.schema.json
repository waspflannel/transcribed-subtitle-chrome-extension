{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/create-subtitle-job-request.schema.json",
  "title": "CreateSubtitleJobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "youtubeVideoId",
    "youtubeUrl",
    "sourceLanguage",
    "targetLanguage",
    "includeRomanization",
    "includeTranslation"
  ],
  "properties": {
    "youtubeVideoId": {
      "type": "string",
      "description": "Canonical 11-character YouTube video ID.",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "youtubeUrl": {
      "type": "string",
      "format": "uri",
      "description": "YouTube watch or Shorts URL captured by the extension for diagnostics and validation."
    },
    "videoDurationSeconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Video duration in seconds."
    },
    "sourceLanguage": {
      "type": "string",
      "enum": [
        "auto",
        "bel",
        "bos",
        "bul",
        "cat",
