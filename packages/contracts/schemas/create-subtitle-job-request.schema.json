        "yor",
        "zul"
      ],
      "description": "Learning/source language requested by the extension. Auto detect is source-only. Language choices are defined by languages.json."
    },
    "targetLanguage": {
      "type": "string",
      "description": "Translation/target language requested by the extension. Auto detect is not allowed for target language.",
      "enum": [
        "bel",
        "bos",
