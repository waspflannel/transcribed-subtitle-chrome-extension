{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/lyrics-correction-status.schema.json",
  "title": "LyricsCorrectionStatus",
  "type": "object",
  "description": "AI selection is pinned per correction. Older backend responses can omit all three AI fields.",
  "dependentRequired": {"aiProvider": ["aiModel", "aiFastMode"], "aiModel": ["aiProvider", "aiFastMode"], "aiFastMode": ["aiProvider", "aiModel"]},
  "if": {"required": ["aiProvider"], "properties": {"aiProvider": {"enum": ["openai", "cerebras"]}}},
  "then": {"properties": {"aiFastMode": {"const": false}}},
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["attemptId", "status", "stage", "updatedAt"],
      "properties": {
        "aiProvider": {"enum": ["openai", "cerebras", "codex"]},
        "aiModel": {"type": "string", "minLength": 1},
        "aiFastMode": {"type": "boolean"},
        "attemptId": {"type": "string", "format": "uuid"},
        "status": {"const": "queued"},
        "stage": {"const": "queued"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    {
      "additionalProperties": false,
      "required": ["attemptId", "status", "stage", "updatedAt"],
      "properties": {
        "aiProvider": {"enum": ["openai", "cerebras", "codex"]},
        "aiModel": {"type": "string", "minLength": 1},
        "aiFastMode": {"type": "boolean"},
        "attemptId": {"type": "string", "format": "uuid"},
        "status": {"const": "running"},
        "stage": {"enum": ["aligning", "rebuilding", "romanizing", "finalizing"]},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    {
      "additionalProperties": false,
      "required": ["attemptId", "status", "stage", "updatedAt", "track"],
      "properties": {
        "aiProvider": {"enum": ["openai", "cerebras", "codex"]},
        "aiModel": {"type": "string", "minLength": 1},
        "aiFastMode": {"type": "boolean"},
        "attemptId": {"type": "string", "format": "uuid"},
        "status": {"const": "completed"},
        "stage": {"const": "completed"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "track": {"$ref": "track-response.schema.json"}
      }
    },
    {
      "additionalProperties": false,
      "required": ["attemptId", "status", "stage", "updatedAt", "errorCode", "message"],
      "properties": {
        "aiProvider": {"enum": ["openai", "cerebras", "codex"]},
        "aiModel": {"type": "string", "minLength": 1},
        "aiFastMode": {"type": "boolean"},
        "attemptId": {"type": "string", "format": "uuid"},
        "status": {"const": "failed"},
        "stage": {"const": "failed"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "errorCode": {"enum": ["lyrics_incomplete", "lyrics_do_not_match", "lyrics_correction_failed"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    {
      "additionalProperties": false,
      "required": ["attemptId", "status", "stage", "updatedAt"],
      "properties": {
        "aiProvider": {"enum": ["openai", "cerebras", "codex"]},
        "aiModel": {"type": "string", "minLength": 1},
        "aiFastMode": {"type": "boolean"},
        "attemptId": {"type": "string", "format": "uuid"},
        "status": {"const": "cancelled"},
        "stage": {"const": "cancelled"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    }
  ]
}
