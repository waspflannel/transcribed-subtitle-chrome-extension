{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/extension-auth-response.schema.json",
  "title": "ExtensionAuthResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account",
    "token"
  ],
  "properties": {
    "account": {
      "$ref": "account-summary.schema.json"
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plainTextToken",
        "tokenType",
        "expiresAt",
        "abilities"
      ],
      "properties": {
        "plainTextToken": {
          "type": "string",
          "minLength": 1
        },
        "tokenType": {
          "type": "string",
          "const": "Bearer"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "abilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "extension:account:read",
              "extension:subtitles:write",
              "extension:tokens:revoke"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
