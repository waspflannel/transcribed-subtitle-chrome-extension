  "$id": "https://transcribed-subtitle-extension.local/schemas/job-response.schema.json",
  "title": "JobResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "youtubeVideoId",
    "sourceLanguage",
    "targetLanguage",
    "includeRomanization",
    "includeTranslation",
    "status",
    "stage",
    "progressPercent",
    "createdAt",
    "updatedAt",
    "aiProvider",
    "aiModel"
