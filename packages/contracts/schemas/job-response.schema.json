      "type": "boolean",
      "description": "Whether the request asked the backend to add romanization where available."
    },
    "includeTranslation": {
      "type": "boolean",
      "description": "Whether the request asked the backend to translate cue text."
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "preparing",
        "acquiring-audio",
        "optimizing-audio",
        "transcribing",
        "tokenizing",
        "romanizing",
        "translating",
        "finalizing"
      ]
    },
    "progressPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "track": {
      "$ref": "track-response.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "detectedSourceLanguage": {
      "type": "string",
      "enum": [
        "bel",
        "bos",
