        "zul"
      ],
      "description": "Provider-detected source language when sourceLanguage was auto and detection produced a catalog language."
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "errorCode": {
      "$ref": "error-object.schema.json#/properties/code"
    },
    "aiProvider": {
      "type": "string",
      "enum": [
        "openai",
        "cerebras"
      ],
      "description": "AI provider for this generation: openai selects Luna; cerebras selects Cerebras. The backend resolves and pins the exact model."
    },
    "aiModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Exact text model saved on this job."
    },
    "partialTrack": {
      "$ref": "partial-track-response.schema.json",
      "description": "Available source cues and completed annotations, delivered with running job status."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "track": {},
          "expiresAt": {}
        },
        "required": [
          "track",
          "expiresAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "track": {}
          },
          "required": [
            "track"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "queued"
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "track": {}
          },
          "required": [
            "track"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "errorCode": {},
          "message": {}
        },
        "required": [
          "errorCode",
          "message"
        ],
        "not": {
          "properties": {
            "track": {}
          },
          "required": [
            "track"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "errorCode": {},
          "message": {}
        },
        "required": [
          "errorCode",
          "message"
        ],
        "not": {
          "properties": {
            "track": {}
          },
          "required": [
            "track"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "partialTrack": {}
        },
        "required": [
          "partialTrack"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      }
    }
  ]
}
