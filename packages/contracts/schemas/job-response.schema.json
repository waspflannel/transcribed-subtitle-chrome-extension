{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/job-response.schema.json",
  "title": "JobResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "youtubeVideoId",
    "sourceLanguage",
    "targetLanguage",
    "track",
    "createdAt",
    "updatedAt",
    "expiresAt"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "youtubeVideoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "sourceLanguage": {
      "type": "string",
      "enum": [
        "auto",
        "ar"
      ]
    },
    "targetLanguage": {
      "type": "string",
      "const": "en"
    },
    "track": {
      "$ref": "track-response.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
