          "description": "Provider-detected source language when sourceLanguage was auto and detection produced a catalog language."
        },
        "aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "cerebras"
          ],
          "description": "AI provider for this generation: openai selects Luna; cerebras selects Cerebras. The backend resolves and pins the exact model."
        },
        "aiModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Exact text model saved on this job."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "errorCode": {},
              "message": {},
              "completedAt": {}
            },
            "required": [
              "errorCode",
              "message",
              "completedAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "completedAt": {},
              "trackId": {},
              "expiresAt": {}
            },
            "required": [
              "completedAt",
              "trackId",
              "expiresAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "completedAt": {},
              "errorCode": {},
              "message": {}
            },
            "required": [
              "completedAt",
              "errorCode",
              "message"
            ]
          }
        }
      ]
    }
