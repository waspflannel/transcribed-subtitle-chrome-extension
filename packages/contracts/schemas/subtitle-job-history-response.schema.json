        "enrichmentMode": {
          "type": "string",
          "enum": [
            "on_demand",
            "full"
          ],
          "description": "Requested word-card mode. This is public-safe generation-control telemetry, not billing or provider output."
        },
        "includeRomanization": {
          "type": "boolean",
          "description": "Whether the request asked the backend to add romanization where available."
        },
        "includeTranslation": {
          "type": "boolean",
          "description": "Whether the request asked the backend to translate cue text."
        },
        "jobId": {
          "type": "string",
          "format": "uuid"
        },
        "trackId": {
          "type": "string",
          "format": "uuid"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "errorCode": {
