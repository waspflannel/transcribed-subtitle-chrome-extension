{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/subtitle-job-history-response.schema.json",
  "title": "SubtitleJobHistoryResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobs"
  ],
  "properties": {
    "jobs": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/SubtitleJobHistoryItem"
      }
    }
  },
  "$defs": {
    "SubtitleJobHistoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "youtubeVideoId",
        "youtubeUrl",
        "status",
        "startedAt",
        "lastUpdatedAt",
        "stage",
        "progressPercent",
        "sourceLanguage",
        "targetLanguage",
        "enrichmentMode",
        "includeRomanization",
        "includeTranslation",
        "jobId",
        "aiProvider",
        "aiModel"
      ],
      "properties": {
        "youtubeVideoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "videoDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "Known video duration in seconds when measured or supplied by the extension. Safe for usage and timing displays."
        },
        "youtubeUrl": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stage": {
          "type": "string",
          "enum": [
            "preparing",
            "acquiring-audio",
            "optimizing-audio",
            "transcribing",
            "tokenizing",
            "romanizing",
            "translating",
            "enriching",
            "finalizing"
          ]
        },
        "progressPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "sourceLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "bel",
