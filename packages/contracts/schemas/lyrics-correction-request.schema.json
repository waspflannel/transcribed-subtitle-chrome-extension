{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/lyrics-correction-request.schema.json",
  "title": "LyricsCorrectionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["lyrics"],
  "properties": {
    "lyrics": {
      "type": "string",
      "minLength": 1,
      "maxLength": 25000,
      "description": "Complete pasted plain-text lyrics. The backend applies a Unicode character limit after validation."
    }
  }
}
