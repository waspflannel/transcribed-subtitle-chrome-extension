{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribed-subtitle-extension.local/schemas/lyrics-correction-request.schema.json",
  "title": "LyricsCorrectionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expectedTrackId",
    "lyrics"
  ],
  "properties": {
    "expectedTrackId": {
      "type": "string",
      "format": "uuid",
      "description": "Identity of the track the learner intends to replace."
    },
    "lyrics": {
      "type": "string",
      "minLength": 1,
      "maxLength": 25000,
      "description": "Pasted plain-text lyrics, at most 25,000 raw Unicode code points. The backend requires a Unicode letter, rejects C0/C1 controls except tab/LF/CR, and rejects HTTP(S)/www link-only input before whitespace normalization."
    },
    "aiProvider": {
      "type": "string",
      "enum": [
        "openai",
        "cerebras",
        "codex",
        "claude",
        "anthropic"
      ],
      "description": "Optional provider override for this correction only. Omit all AI fields to inherit the generation’s saved provider, model, and fast mode."
    },
    "aiModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Required for Codex (a model from the connected account), Claude subscription and Claude API (models listed below); omitted for other providers."
    },
    "aiFastMode": {
      "type": "boolean",
      "default": false,
      "description": "Codex fast service tier, or Claude API fast mode on Opus 5.5, Opus 5 and Opus 4.8. Omitted for other providers."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "aiProvider"
        ],
        "properties": {
          "aiProvider": {
            "enum": [
              "codex",
              "claude",
              "anthropic"
            ]
          }
        }
      },
      "then": {
        "required": [
          "aiModel"
        ]
      },
      "else": {
        "not": {
          "required": [
            "aiModel"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "aiProvider"
        ],
        "properties": {
          "aiProvider": {
            "enum": [
              "codex",
              "anthropic"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "aiFastMode": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "aiProvider"
        ],
        "properties": {
          "aiProvider": {
            "const": "claude"
          }
        }
      },
      "then": {
        "properties": {
          "aiModel": {
            "enum": [
              "opus",
              "sonnet",
              "haiku",
              "claude-fable-5-1",
              "claude-opus-5",
              "claude-opus-4-8",
              "claude-sonnet-5"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "aiProvider"
        ],
        "properties": {
          "aiProvider": {
            "const": "anthropic"
          }
        }
      },
      "then": {
        "properties": {
          "aiModel": {
            "enum": [
              "claude-opus-5-5",
              "claude-sonnet-5-5",
              "claude-haiku-5-5",
              "claude-fable-5-1",
              "claude-opus-5",
              "claude-opus-4-8",
              "claude-sonnet-5"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "aiProvider",
          "aiFastMode"
        ],
        "properties": {
          "aiProvider": {
            "const": "anthropic"
          },
          "aiFastMode": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "aiModel": {
            "enum": [
              "claude-opus-5-5",
              "claude-opus-5",
              "claude-opus-4-8"
            ]
          }
        }
      }
    }
  ]
}
